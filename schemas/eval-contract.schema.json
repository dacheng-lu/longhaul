{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dacheng-lu/longhaul/schemas/eval-contract.schema.json",
  "title": "Longhaul local-model evaluation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "matrix", "suites", "scoring", "retrieval", "gates", "failure_policy", "execution"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "matrix": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "repo", "revision", "file", "bytes", "sha256", "arch", "quant", "tier"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "arch": {"type": "string", "minLength": 1},
          "quant": {"type": "string", "minLength": 1},
          "tier": {"enum": ["full", "variant"]}
        }
      }
    },
    "suites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "cases": {"type": "integer", "minimum": 0},
          "case_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["scorer", "version", "normalization"],
      "properties": {
        "scorer": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "scorer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalization": {"type": "array", "items": {"type": "string"}}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["embedding_model", "dim"],
      "properties": {
        "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "embedding_model": {"type": "string", "minLength": 1},
        "dim": {"type": "integer", "minimum": 1},
        "case_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gates": {"type": "object"},
    "failure_policy": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_sha256", "server"],
      "properties": {
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "server": {"type": "string", "minLength": 1},
        "command_template": {"type": "string"}
      }
    }
  }
}
